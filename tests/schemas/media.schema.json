{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media.schema.json",
  "$defs": {
    "job": {
      "type": "object",
      "required": [
        "schemaVersion",
        "provider",
        "status",
        "url",
        "output_node",
        "client_id",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "provider": {
          "const": "comfyui"
        },
        "status": {
          "enum": [
            "preparing",
            "unknown",
            "pending",
            "failed",
            "done"
          ]
        },
        "url": {
          "type": "string"
        },
        "output_node": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "frameCount": {
          "type": "integer",
          "minimum": 5
        },
        "fps": {
          "const": 24
        },
        "durationRequested": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "durationUsed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "prompt_id": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "required": [
              "prompt_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "done"
              }
            }
          },
          "then": {
            "required": [
              "prompt_id",
              "artifact",
              "sha256"
            ]
          }
        }
      ]
    }
  }
}
