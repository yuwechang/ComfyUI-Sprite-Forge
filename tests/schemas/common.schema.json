{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\\\]+$"
    },
    "fileRef": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "eventName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
    },
    "fpsValue": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
        }
      ]
    },
    "durationsMs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "seamReport": {
      "type": "object",
      "required": [
        "seam",
        "adjacent_median",
        "adjacent_p95",
        "seam_over_median",
        "seam_over_p95"
      ],
      "properties": {
        "frames": {
          "type": "integer",
          "minimum": 2
        },
        "seam": {
          "type": "number",
          "minimum": 0
        },
        "adjacent_median": {
          "type": "number",
          "minimum": 0
        },
        "adjacent_p95": {
          "type": "number",
          "minimum": 0
        },
        "adjacent_max": {
          "type": "number",
          "minimum": 0
        },
        "seam_over_median": {
          "type": "number",
          "minimum": 0
        },
        "seam_over_p95": {
          "type": "number",
          "minimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
